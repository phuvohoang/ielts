{
  "name": "ielts-grammar-grader",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "vars": {
    "ALLOWED_ORIGINS": "https://phuvohoang.github.io",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_SCHEMA_STYLE": "openai",
    "AI_DISABLE_THINKING": "true",
    "AI_CRITERIA_GRADING": "true",
    "AI_SOURCE_COVERAGE": "true",
    "AI_GENERATION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_GENERATION_SCHEMA_STYLE": "openai",
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-lite-tts",
    "AI_PRACTICE_ONLY": "true"
  },
  "ratelimits": [
    {
      "name": "GRADE_LIMIT",
      "namespace_id": "2901",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMIT",
      "namespace_id": "2902",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "GENERATE_LIMIT",
      "namespace_id": "2903",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "previews": {
    "vars": {
      "ALLOWED_ORIGINS": "https://phuvohoang.github.io",
      "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
      "AI_SCHEMA_STYLE": "openai",
      "AI_DISABLE_THINKING": "true",
      "AI_CRITERIA_GRADING": "true",
      "AI_SOURCE_COVERAGE": "true",
      "AI_GENERATION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "AI_GENERATION_SCHEMA_STYLE": "openai",
      "AI_PROVIDER": "gemini",
      "GEMINI_MODEL": "gemini-3.5-flash-lite",
      "GEMINI_TTS_MODEL": "gemini-3.8-flash-lite-tts",
      "AI_PRACTICE_ONLY": "true"
    },
    "ratelimits": [
      {
        "name": "GRADE_LIMIT",
        "namespace_id": "3901",
        "simple": {
          "limit": 6,
          "period": 60
        }
      },
      {
        "name": "GLOBAL_LIMIT",
        "namespace_id": "3902",
        "simple": {
          "limit": 30,
          "period": 60
        }
      },
      {
        "name": "GENERATE_LIMIT",
        "namespace_id": "3903",
        "simple": {
          "limit": 12,
          "period": 60
        }
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "SESSIONS",
          "class_name": "GrammarSessions"
        }
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "GrammarSessions"
      }
    ]
  },
  "migrations": [
    {
      "tag": "dynamic-sessions-v1",
      "new_sqlite_classes": [
        "GrammarSessions"
      ]
    }
  ]
}
