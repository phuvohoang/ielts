{
  "name": "ielts-grammar-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:check": "node scripts/sync-worker-config.mjs --check && wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:sync-config": "node scripts/sync-worker-config.mjs",
    "worker:preview": "wrangler preview --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dexie": "^4.4.7",
    "diff": "^9.0.0",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
